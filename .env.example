WG_USER=your@email.address
WG_PASS=your_waterguru_password

# Optional: push notifications when status goes RED. Subscribe in the ntfy app.
NTFY_TOPIC=

# Where to publish. Leave NTFY_URL blank to use the public https://ntfy.sh, in
# which case pick a random, hard-to-guess topic name above - ntfy.sh topics are
# not access-controlled, so anyone who knows the name can read your alerts.
#
# Pointed at a self-hosted ntfy instead, the topic IS access-controlled and
# NTFY_USER/NTFY_PASS are required (anonymous requests are refused). The
# credentials below are write-only on this topic alone: they cannot read it
# back, and cannot publish to any other topic.
NTFY_URL=
NTFY_USER=
NTFY_PASS=

# Optional: lat/lon for the 5-day swim-weather forecast (National Weather Service,
# US locations only). Look yours up at https://www.latlong.net/ or via zip code.
WX_LAT=
WX_LON=
PENTAIR_HOST=                     # optional, Pentair IntelliCenter IP (local, port 6680)
PUMP_RUNTIME_HOURS=                # optional, pump hours/day if on a fixed schedule

# Optional: override the pool surface if WaterGuru has it wrong. One of
# PLASTER, PEBBLE, QUARTZ, TILE, VINYL, FIBERGLASS. Decides what a corrosive
# saturation index is attacking, and therefore how much calcium is worth adding.
POOL_SURFACE=
