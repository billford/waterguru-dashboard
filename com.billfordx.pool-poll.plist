<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Samples the Pentair controller every 10 minutes to measure real pump runtime.
  Local, unauthenticated, read-only - unlike the WaterGuru API there's no reason
  to be sparing, and duty cycle can't be inferred from two samples a day.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.billfordx.pool-poll</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/billfordx/Projects/waterguru/venv/bin/python</string>
        <string>/Users/billfordx/Projects/waterguru/poll_system.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/billfordx/Projects/waterguru</string>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <!-- Python writes data/poll.log itself with rotation. launchd must not own
         that file: it holds the fd open, so a rename would leave it writing to
         an unlinked inode. See logs.py. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/Users/billfordx/Projects/waterguru/data/poll.err.log</string>
</dict>
</plist>
