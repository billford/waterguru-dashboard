.env
venv/
__pycache__/
*.pyc
.pytest_cache/
.wrangler/

# Everything under data/ is generated by a run: the SQLite database, the raw
# JSONL archive, and the launchd logs. The directory is recreated as needed.
# Leading slash anchors this to the repo root - unanchored, it would also
# swallow site/data/ and its .gitkeep.
/data/

# Generated dashboard payloads. A pattern rather than file-by-file, so adding a
# new exporter doesn't silently start committing its output.
site/data/*
!site/data/.gitkeep
